# Environment variables for AI IDX Investment Research Copilot
# Copy this file to .env and fill in real values

# Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here

# Sectors Financial API Key (passed server-side, never exposed to browser)
SECTORS_API_KEY=your_sectors_api_key_here

# Django SECRET_KEY
DJANGO_SECRET_KEY=django-insecure-dev-do-not-use-in-production

# Optional: Override default cache backend
# DJANGO_CACHE_BACKEND=localmemory   # use: localmemory, redis, db, memory

# Optional: Override database engine
# DATABASE_ENGINE=sqlite3   # or postgresql, mysql

# Optional: Allowed hosts for production
# ALLOWED_HOSTS=localhost,127.0.0.1,example.com