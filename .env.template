# ==============================================================================
# AI IDX Investment Research Copilot - Environment Configuration Template
# Copy this file to '.env' and fill in your active credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED API KEYS
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Get from: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Sectors Financial API Key (Get from: https://sectors.app/)
SECTORS_API_KEY=your_sectors_api_key_here


# ------------------------------------------------------------------------------
# 2. DJANGO CORE & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Django Cryptographic Secret Key (Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=django-insecure-dev-do-not-use-in-production

# Enable Debug Mode (Set to False in production)
DJANGO_DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Comma-separated list of trusted origins for CSRF-protected POST requests
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Optional: External PostgreSQL connection URL (e.g., Neon Serverless Postgres, Supabase)
# If omitted, defaults to SQLite in 'database/db.sqlite3' (or '/tmp/db.sqlite3' on Vercel)
# DATABASE_URL=postgres://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require


# ------------------------------------------------------------------------------
# 4. GROQ MODEL OVERRIDES
# ------------------------------------------------------------------------------
# Primary model for comprehensive equity research synthesis and valuation verdicts
# GROQ_PRIMARY_MODEL=openai/gpt-oss-120b

# Fast model for intent parsing and lightweight tasks
# GROQ_FAST_MODEL=openai/gpt-oss-20b


# ------------------------------------------------------------------------------
# 5. CACHING & PERFORMANCE
# ------------------------------------------------------------------------------
# Cache Backend: 'localmemory', 'redis', or 'db'
DJANGO_CACHE_BACKEND=localmemory

# Cache Location: Instance identifier or Redis URL (e.g., redis://127.0.0.1:6379/1)
DJANGO_CACHE_LOCATION=unique-cache

# Cache TTL in seconds for Sectors API responses (default: 300s / 5 minutes)
DJANGO_CACHE_TIMEOUT=300